module

public import SubalgebraFreeness.Reduction
public import SubalgebraFreeness.RingFree
public import Mathlib.Computability.Reduce

/-! # Undecidability of freeness for finitely generated subalgebras

`K⟨a, b⟩` is `FreeAlgebra K Bool`, with `a = false` and `b = true`. A finite set of generators is
given by a list of `WordSpec`s: a binary word, or a pair of binary words denoting their
difference. `generated K Y` is the unital `K`-subalgebra they generate. An algorithm is a
computable predicate in the sense of Mathlib (`ComputablePred`), on the encodable type of such
lists.

* `freeness_undecidable`: for every field `K`, no algorithm decides whether `generated K Y` is
  isomorphic as a `K`-algebra to a free algebra `K⟨B⟩`.
* `ring_freeness_undecidable`: the same holds for ring isomorphisms.
* `polynomial_freeness_undecidable`: the problem stays undecidable for any presentation of
  arbitrary finite sets of polynomials in which words and differences of words can be computed.
* `computation_free_iff`: the algebra encoding a Turing machine on an input is free exactly
  when the machine does not halt. -/

@[expose] public section
namespace SubalgebraFreeness

open Turing

universe u v

/-- **Encoding a computation.** For a Turing machine `M` in Mathlib's `TM0` model and an input
`w`, the subalgebra `A` generated by `D` and the differences `ℓᵢ - rᵢ` of `Machine.rules M w` is
free exactly when `M` does not halt on `w`. If `M` does not halt, `A` is free on one letter per
symbol of `D` and one per rule. If `M` halts, `A` is isomorphic to no free algebra. -/
theorem computation_free_iff {K : Type v} [Field K] {Γ Λ : Type*} [Inhabited Γ] [Inhabited Λ]
    (M : TM0.Machine Γ Λ) (w : List Γ) :
    (Nonempty (((Machine.rules M w).pres K).range ≃ₐ[K] FreeAlgebra K (Cell Γ ⊕ Rule Γ Λ)) ↔
        ¬ Machine.Halts M w) ∧
      (Machine.Halts M w → ∀ B : Type u, IsEmpty (((Machine.rules M w).pres K).range ≃ₐ[K]
        FreeAlgebra K B)) := by
  have hf := Machine.functional M w
  have hbare : ∀ i, ¬ (Machine.rules M w).Periodic ((Machine.rules M w).lhs i) :=
    Machine.lhs_not_periodic M w
  have hcycle : ∀ B : Type u, Machine.Halts M w →
      IsEmpty (((Machine.rules M w).pres K).range ≃ₐ[K] FreeAlgebra K B) := by
    intro B hhalt
    obtain ⟨x, hx⟩ := (Machine.periodic_iff_halts M w).mpr hhalt
    exact ⟨fun e => ((Machine.rules M w).not_free_of_periodic (K := K) hf hbare hx).false
      (e.trans FreeAlgebra.equivMonoidAlgebraFreeMonoid)⟩
  refine ⟨⟨fun ⟨e⟩ hhalt => ?_, fun hhalt => ?_⟩, fun hhalt B => hcycle B hhalt⟩
  · obtain ⟨x, hx⟩ := (Machine.periodic_iff_halts M w).mpr hhalt
    exact ((Machine.rules M w).not_free_of_periodic (K := K) hf hbare hx).false
      (e.trans FreeAlgebra.equivMonoidAlgebraFreeMonoid)
  · obtain ⟨e⟩ := (Machine.rules M w).free_of_no_periodic (K := K) hf fun x hx =>
      hhalt ((Machine.periodic_iff_halts M w).mp ⟨x, hx⟩)
    exact ⟨e.trans FreeAlgebra.equivMonoidAlgebraFreeMonoid.symm⟩

/-- The program with code `c` halts on `0` exactly when the subalgebra generated by the
specifications of the universal machine on `c` is not free. -/
theorem halts_iff_not_free (K : Type v) [Field K] (c : Nat.Partrec.Code) :
    (c.eval 0).Dom ↔
      ¬ ∃ B : Type u, Nonempty (generated K (Reduction.specs (Encodable.encode c)) ≃ₐ[K]
        FreeAlgebra K B) := by
  rw [Reduction.free_iff_not_halts, not_not, Universal.halts_iff, Denumerable.ofNat_encode]

theorem specs_computable :
    Computable fun c : Nat.Partrec.Code => Reduction.specs (Encodable.encode c) :=
  (Primrec.list_append.comp (Primrec.const _) (Primrec.list_cons.comp
    (Reduction.resetSpec_primrec.comp Primrec.encode) (Primrec.const []))).to_comp

/-- **Theorem.** Fix a field `K`. Even for finite sets of generators given by words and by
differences of two words, no algorithm decides whether the generated unital `K`-subalgebra of
`K⟨a, b⟩` is isomorphic to a free algebra `K⟨B⟩` on some alphabet `B`. -/
theorem freeness_undecidable (K : Type v) [Field K] :
    ¬ ComputablePred fun Y : List WordSpec =>
      ∃ B : Type u, Nonempty (generated K Y ≃ₐ[K] FreeAlgebra K B) := by
  intro h
  apply ComputablePred.halting_problem 0
  have hred := ComputablePred.computable_of_manyOneReducible
    (ManyOneReducible.mk _ specs_computable) h
  exact hred.not.of_eq fun c => (halts_iff_not_free K c).symm

/-- In a unital subalgebra of a free algebra, ring freeness and `K`-algebra freeness agree. -/
theorem ringEquiv_iff_algEquiv {K : Type v} [Field K] (A : Subalgebra K (FreeAlgebra K Bool)) :
    (∃ B : Type u, Nonempty (A ≃+* FreeAlgebra K B)) ↔
      ∃ B : Type u, Nonempty (A ≃ₐ[K] FreeAlgebra K B) := by
  constructor
  · rintro ⟨B, ⟨σ⟩⟩
    have hA : ∀ x : A, IsUnit x → x ∈ Set.range (algebraMap K A) := by
      intro x hx
      obtain ⟨k, hk⟩ := FreeAlgebra.mem_range_of_isUnit (hx.map A.val)
      exact ⟨k, Subtype.ext hk⟩
    obtain ⟨e⟩ := nonempty_algEquiv_of_ringEquiv hA σ.symm
    exact ⟨B, ⟨e.symm⟩⟩
  · rintro ⟨B, ⟨e⟩⟩
    exact ⟨B, ⟨e.toRingEquiv⟩⟩

/-- **The conclusion also holds for ring isomorphisms.** -/
theorem ring_freeness_undecidable (K : Type v) [Field K] :
    ¬ ComputablePred fun Y : List WordSpec =>
      ∃ B : Type u, Nonempty (generated K Y ≃+* FreeAlgebra K B) := fun h =>
  freeness_undecidable.{u} K (h.of_eq fun Y => ringEquiv_iff_algEquiv (generated K Y))

/-- **Arbitrary finite sets of polynomials.** Let polynomials be presented by an encodable type
`P` with an interpretation `decode`, such that each word and each difference of two words has a
presentation computable from it. Then no algorithm decides freeness of the subalgebra generated
by a finite list of presented polynomials. This applies over every computable field. -/
theorem polynomial_freeness_undecidable (K : Type v) [Field K] {P : Type*} [Primcodable P]
    (decode : P → FreeAlgebra K Bool) (enc : WordSpec → P) (henc : Computable enc)
    (hdec : ∀ y, decode (enc y) = WordSpec.eval K y) :
    ¬ ComputablePred fun L : List P =>
      ∃ B : Type u, Nonempty (Algebra.adjoin K {p | ∃ x ∈ L, decode x = p} ≃ₐ[K]
        FreeAlgebra K B) := by
  intro h
  apply ComputablePred.halting_problem 0
  have hcomp : Computable fun c : Nat.Partrec.Code =>
      (Reduction.specs (Encodable.encode c)).map enc := by
    refine (Computable.list_append.comp (Computable.const (Reduction.fixedSpecs.map enc))
      (Computable.list_cons.comp (henc.comp ((Reduction.resetSpec_primrec.comp
        Primrec.encode).to_comp)) (Computable.const []))).of_eq fun c => ?_
    simp [Reduction.specs]
  have hred := ComputablePred.computable_of_manyOneReducible (ManyOneReducible.mk _ hcomp) h
  refine hred.not.of_eq fun c => ?_
  rw [halts_iff_not_free.{u} K c]
  have hset : {p | ∃ x ∈ (Reduction.specs (Encodable.encode c)).map enc, decode x = p} =
      {p | ∃ y ∈ Reduction.specs (Encodable.encode c), WordSpec.eval K y = p} := by
    ext p
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
      exact ⟨y, hy, (hdec y).symm⟩
    · rintro ⟨y, hy, rfl⟩
      exact ⟨enc y, List.mem_map.mpr ⟨y, hy, rfl⟩, hdec y⟩
  rw [hset]
  rfl

end SubalgebraFreeness
