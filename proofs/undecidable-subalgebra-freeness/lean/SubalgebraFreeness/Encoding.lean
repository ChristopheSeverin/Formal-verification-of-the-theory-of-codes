module

public import SubalgebraFreeness.Poly
public import SubalgebraFreeness.LinearPart
public import Mathlib.RingTheory.Adjoin.Basic

/-! # Words and differences of words in `K⟨a, b⟩`

The input of the decision problem is a finite list of specifications, each a binary word or a
pair of binary words, with `a = false` and `b = true`. A specification denotes the word or the
difference of the two words in `K⟨a, b⟩ = FreeAlgebra K Bool`.

A finite auxiliary alphabet `c₀, c₁, …` is encoded by `cⱼ ↦ aʲ b`. Each `b` ends one block, so
distinct words have distinct images, and the linear extension embeds `K⟨c₀, c₁, …⟩` in
`K⟨a, b⟩`. -/

@[expose] public noncomputable section
namespace SubalgebraFreeness

open MonoidAlgebra

/-- A generator given by a binary word (`inl w`) or by a difference of two binary words
(`inr (u, v)`), with `a = false` and `b = true`. -/
abbrev WordSpec := List Bool ⊕ (List Bool × List Bool)

variable (K : Type*) [Field K]

/-- The element of `K⟨a, b⟩` given by a binary word. -/
def word (w : List Bool) : FreeAlgebra K Bool := (w.map (FreeAlgebra.ι K)).prod

/-- The element of `K⟨a, b⟩` denoted by a specification. -/
def WordSpec.eval : WordSpec → FreeAlgebra K Bool
  | .inl w => word K w
  | .inr (u, v) => word K u - word K v

/-- The unital `K`-subalgebra of `K⟨a, b⟩` generated by a finite list of specifications. -/
def generated (Y : List WordSpec) : Subalgebra K (FreeAlgebra K Bool) :=
  Algebra.adjoin K {p | ∃ y ∈ Y, WordSpec.eval K y = p}

theorem word_append (u v : List Bool) : word K (u ++ v) = word K u * word K v := by
  simp [word]

/-! ### The block code `cⱼ ↦ aʲ b` -/

/-- The block `aʲ b`. -/
def block (j : ℕ) : List Bool := List.replicate j false ++ [true]

/-- The binary code of a word over an alphabet numbered by `idx`. -/
def code {α : Type*} (idx : α → ℕ) (w : List α) : List Bool := w.flatMap fun x => block (idx x)

theorem block_append_inj {j j' : ℕ} {l l' : List Bool} (h : block j ++ l = block j' ++ l') :
    j = j' ∧ l = l' := by
  induction j generalizing j' with
  | zero =>
    cases j' with
    | zero => simpa [block] using h
    | succ j' => simp [block, List.replicate_succ] at h
  | succ j ih =>
    cases j' with
    | zero => simp [block, List.replicate_succ] at h
    | succ j' =>
      simp only [block, List.replicate_succ, List.cons_append, List.append_assoc,
        List.cons.injEq, true_and] at h
      obtain ⟨rfl, rfl⟩ := ih (by simpa [block] using h)
      exact ⟨rfl, rfl⟩

theorem code_injective {α : Type*} {idx : α → ℕ} (hidx : Function.Injective idx) :
    Function.Injective (code idx) := by
  intro u v h
  induction u generalizing v with
  | nil =>
    cases v with
    | nil => rfl
    | cons y v => simp [code, block] at h
  | cons x u ih =>
    cases v with
    | nil => simp [code, block] at h
    | cons y v =>
      simp only [code, List.flatMap_cons] at h
      obtain ⟨hxy, huv⟩ := block_append_inj h
      rw [hidx hxy, ih huv]

variable {K}

/-- The image of a word under `FreeAlgebra.equivMonoidAlgebraFreeMonoid`. -/
theorem equiv_word (w : List Bool) :
    FreeAlgebra.equivMonoidAlgebraFreeMonoid (word K w) = mono (FreeMonoid.ofList w) := by
  induction w with
  | nil => simp [word, mono]; rfl
  | cons b w ih =>
    rw [show word K (b :: w) = FreeAlgebra.ι K b * word K w from rfl, map_mul, ih,
      show (FreeMonoid.ofList (b :: w) : FreeMonoid Bool) = FreeMonoid.of b * FreeMonoid.ofList w
        from rfl, mono_mul]
    congr 1
    simp [FreeAlgebra.equivMonoidAlgebraFreeMonoid, mono]

variable (K) in
/-- The embedding `cⱼ ↦ aʲ b` of `K⟨α⟩` in `K⟨a, b⟩`. -/
def embed {α : Type*} (idx : α → ℕ) : Poly K α →ₐ[K] FreeAlgebra K Bool :=
  polyLift fun x => word K (block (idx x))

theorem embed_mono {α : Type*} (idx : α → ℕ) (w : FreeMonoid α) :
    embed K idx (mono w) = word K (code idx w.toList) := by
  induction w using FreeMonoid.inductionOn' with
  | one => simp [mono_one, code, word]
  | of_mul x w ih =>
    rw [mono_mul, map_mul, ih, show (mono (FreeMonoid.of x) : Poly K α) = letter x from rfl, embed,
      polyLift_letter]
    simp only [FreeMonoid.toList_mul, FreeMonoid.toList_of, List.singleton_append, code,
      List.flatMap_cons, word_append]

theorem embed_injective {α : Type*} {idx : α → ℕ} (hidx : Function.Injective idx) :
    Function.Injective (embed K idx) := by
  let c : FreeMonoid α →* FreeMonoid Bool := FreeMonoid.lift fun x => FreeMonoid.ofList (block (idx x))
  have hc : ∀ w : FreeMonoid α, c w = FreeMonoid.ofList (code idx w.toList) := by
    intro w
    induction w using FreeMonoid.inductionOn' with
    | one => rfl
    | of_mul x w ih =>
      rw [map_mul, ih]
      simp [c, code]
  have hcinj : Function.Injective c := by
    intro u v h
    rw [hc, hc] at h
    exact FreeMonoid.ext (code_injective hidx (congrArg FreeMonoid.toList h))
  have key : ((FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := K) (X := Bool)).toAlgHom.comp
      (embed K idx)) = mapDomainAlgHom K K c := by
    apply algHom_ext_letter
    intro x
    change FreeAlgebra.equivMonoidAlgebraFreeMonoid (embed K idx (letter x)) =
      mapDomainAlgHom K K c (letter x)
    rw [embed, polyLift_letter, equiv_word]
    simp [mono, letter, c]
  intro p q h
  have h' : mapDomainAlgHom K K c p = mapDomainAlgHom K K c q := by
    rw [← key]
    exact congrArg (fun r => FreeAlgebra.equivMonoidAlgebraFreeMonoid r) h
  exact MonoidAlgebra.mapDomain_injective hcinj h'

/-- The range of `polyLift f` is the subalgebra generated by the values of `f`. -/
theorem range_polyLift {α A : Type*} [Semiring A] [Algebra K A] (f : α → A) :
    (polyLift f : Poly K α →ₐ[K] A).range = Algebra.adjoin K (Set.range f) := by
  have hword : ∀ w : FreeMonoid α, polyLift f (mono w : Poly K α) ∈ Algebra.adjoin K (Set.range f) := by
    intro w
    induction w using FreeMonoid.inductionOn' with
    | one => simp [mono_one]
    | of_mul x w ih =>
      rw [mono_mul, map_mul]
      refine Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨x, ?_⟩) ih
      exact (polyLift_letter f x).symm
  apply le_antisymm
  · intro y hy
    obtain ⟨p, rfl⟩ := (AlgHom.mem_range _).mp hy
    rw [sum_single p, map_sum]
    exact Subalgebra.sum_mem _ fun w _ => by
      rw [map_smul]
      exact Subalgebra.smul_mem _ (hword w) _
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨x, rfl⟩
    exact ⟨letter x, polyLift_letter f x⟩

/-- The subalgebra of `K⟨a, b⟩` generated by the encoded generators is isomorphic to the
subalgebra they generate before encoding. -/
def generatedEquiv {α ι : Type*} {idx : α → ℕ} (hidx : Function.Injective idx)
    (g : ι → Poly K α) (Y : List WordSpec)
    (hY : {p | ∃ y ∈ Y, WordSpec.eval K y = p} = embed K idx '' Set.range g) :
    generated K Y ≃ₐ[K] (polyLift g : Poly K ι →ₐ[K] Poly K α).range := by
  refine (Subalgebra.equivOfEq _ _ ?_).trans
    ((Subalgebra.equivMapOfInjective _ (embed K idx) (embed_injective hidx)).symm)
  rw [generated, hY, ← AlgHom.map_adjoin, range_polyLift]

end SubalgebraFreeness
