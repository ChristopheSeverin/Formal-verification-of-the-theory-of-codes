module

public import SubalgebraFreeness.Words

/-! # The algebraic graph criterion

Let `D`, `S` be alphabets and `ℓᵢ → rᵢ` rules with both sides in `D* S D*`. The algebra `A` is
generated by `D` and the differences `ℓᵢ - rᵢ`. With one new letter `zᵢ` per rule, the map
`π : K⟨D ∪ Z⟩ → A` fixes `D` and sends `zᵢ` to `ℓᵢ - rᵢ`. Its degree-one part is the incidence
map `u zᵢ v ↦ u ℓᵢ v - u rᵢ v` of the rewriting graph.

* `pres_injective`: if the incidence map is injective, so is `π`. The rule letters are replaced
  from left to right. At each stage the already-replaced prefix and the remaining suffix are fixed,
  and the substitution in the middle is the incidence map.
* `highOrder_of_pres_eq_zero`: if no kernel element of the incidence map involves a bare rule
  letter `(1, i, 1)`, then every relation lies in `I²`.
Under this hypothesis, `A` is free exactly when the incidence map is injective. The two
directions are `free_of_incidence_injective` and `incidence_injective_of_free` in
`GraphCriterion`. -/

@[expose] public section
namespace SubalgebraFreeness

open MonoidAlgebra

variable {K : Type*} [Field K] {D S ι : Type*}

/-- Rules `ℓᵢ → rᵢ` with both sides in `D* S D*`. -/
structure Rules (D S ι : Type*) where
  lhs : ι → Vertex D S
  rhs : ι → Vertex D S

namespace Rules

variable (R : Rules D S ι)

/-- The source `u ℓᵢ v` of the edge `(u, i, v)`. -/
def src (e : Edge D ι) : Vertex D S := put e.1 (R.lhs e.2.1) e.2.2

/-- The target `u rᵢ v` of the edge `(u, i, v)`. -/
def tgt (e : Edge D ι) : Vertex D S := put e.1 (R.rhs e.2.1) e.2.2

variable (K) in
/-- The generators of `A`: the letters of `D` and the differences `ℓᵢ - rᵢ`. -/
noncomputable def gen : D ⊕ ι → Poly K (D ⊕ S)
  | .inl d => letter (.inl d)
  | .inr i => mono (vword (R.lhs i)) - mono (vword (R.rhs i))

variable (K) in
/-- The presentation `π : K⟨D ∪ Z⟩ → K⟨D ∪ S⟩`. -/
noncomputable def pres : Poly K (D ⊕ ι) →ₐ[K] Poly K (D ⊕ S) := polyLift (R.gen K)

variable (K) in
/-- The incidence map `u zᵢ v ↦ u ℓᵢ v - u rᵢ v` on finitely supported combinations of edges. -/
noncomputable def incidence : (Edge D ι →₀ K) →ₗ[K] (Vertex D S →₀ K) :=
  Finsupp.linearCombination K fun e => Finsupp.single (R.src e) 1 - Finsupp.single (R.tgt e) 1

theorem incidence_single (e : Edge D ι) (c : K) :
    R.incidence K (Finsupp.single e c) =
      c • (Finsupp.single (R.src e) 1 - Finsupp.single (R.tgt e) 1) := by
  simp [incidence]

theorem pres_dword (u : List D) : R.pres K (mono (dword u)) = mono (dword u) := by
  induction u with
  | nil => simp [dword_nil, mono_one]
  | cons d u ih =>
    rw [show (dword (d :: u) : FreeMonoid (D ⊕ ι)) = FreeMonoid.of (.inl d) * dword u from rfl,
      show (dword (d :: u) : FreeMonoid (D ⊕ S)) = FreeMonoid.of (.inl d) * dword u from rfl,
      mono_mul, mono_mul, map_mul, ih]
    change polyLift (R.gen K) (letter (.inl d)) * _ = _
    rw [polyLift_letter]
    rfl

theorem pres_eword (e : Edge D ι) :
    R.pres K (mono (eword e)) = mono (vword (R.src e)) - mono (vword (R.tgt e)) := by
  obtain ⟨u, i, v⟩ := e
  rw [eword, vword_eq, mono_mul, mono_mul, map_mul, map_mul, pres_dword, pres_dword]
  change mono (dword u) * polyLift (R.gen K) (letter (.inr i)) * mono (dword v) = _
  rw [polyLift_letter, src, tgt, vword_put, vword_put, mono_mul, mono_mul, mono_mul, mono_mul]
  simp only [gen, mul_sub, sub_mul]

theorem constCoeff_gen (x : D ⊕ ι) : constCoeff (R.gen K x) = 0 := by
  rcases x with d | i
  · simp [gen, constCoeff_apply, letter, mono]
  · rw [gen, map_sub, constCoeff_apply, constCoeff_apply, mono, mono, coeff_single, coeff_single,
      Finsupp.single_eq_of_ne' (vword_ne_one _), Finsupp.single_eq_of_ne' (vword_ne_one _),
      sub_zero]

/-! ### Stepwise substitution -/

/-- A stage of the substitution: blocks already produced, the current word over `D`, and the
remaining rule letters with their following words over `D`. -/
abbrev State (D S ι : Type*) := List (List D × S) × List D × List (ι × List D)

variable (K) in
/-- Replace the remaining rule letters from left to right. -/
noncomputable def subst : List (ι × List D) → List (List D × S) → List D → (Out D S →₀ K)
  | [], sb, c => Finsupp.single (sb, c) 1
  | (i, v) :: rest, sb, c =>
      subst rest (sb ++ [((R.src (c, i, v)).1, (R.src (c, i, v)).2.1)]) (R.src (c, i, v)).2.2 -
      subst rest (sb ++ [((R.tgt (c, i, v)).1, (R.tgt (c, i, v)).2.1)]) (R.tgt (c, i, v)).2.2

variable (K) in
/-- The substitution, extended linearly to combinations of stages. -/
noncomputable def substLin : (State D S ι →₀ K) →ₗ[K] (Out D S →₀ K) :=
  Finsupp.linearCombination K fun st => R.subst K st.2.2 st.1 st.2.1

variable (K D S) in
/-- Words from block decompositions, as a linear map. -/
noncomputable def toPoly : (Out D S →₀ K) →ₗ[K] Poly K (D ⊕ S) :=
  (coeffLinearEquiv K).symm.toLinearMap ∘ₗ Finsupp.lmapDomain K K flatOut

omit [Field K] in
theorem toPoly_single [Field K] (o : Out D S) (c : K) :
    toPoly K D S (Finsupp.single o c) = single (flatOut o) c := by
  simp [toPoly]

theorem toPoly_injective : Function.Injective (toPoly K D S) := by
  intro f g h
  have h' := congrArg MonoidAlgebra.coeff h
  simp only [toPoly, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
    coeffLinearEquiv_symm_apply, Finsupp.lmapDomain_apply] at h'
  exact Finsupp.mapDomain_injective flatOut_injective h'

/-- The substitution computes `π` on the remaining suffix. -/
theorem subst_spec (zr : List (ι × List D)) (sb : List (List D × S)) (c : List D) :
    mono (flatOut (sb, c)) * R.pres K (mono (zword zr)) = toPoly K D S (R.subst K zr sb c) := by
  induction zr generalizing sb c with
  | nil =>
    rw [zword_nil, mono_one, map_one, mul_one, subst, toPoly_single]
    rfl
  | cons p rest ih =>
    obtain ⟨i, v⟩ := p
    rw [zword_cons, mono_mul, mono_mul, map_mul, map_mul, pres_dword]
    change _ * (polyLift (R.gen K) (letter (.inr i)) * _ * _) = _
    rw [polyLift_letter, subst, map_sub, ← ih, ← ih]
    simp only [gen, ← mul_assoc, sub_mul, mul_sub]
    rw [← mono_mul, ← mono_mul, ← mono_mul, ← mono_mul, flatOut_close, flatOut_close]
    rfl

theorem pres_flatIn (u : List D) (zr : List (ι × List D)) :
    R.pres K (mono (flatIn (u, zr))) = toPoly K D S (R.subst K zr [] u) := by
  rw [← subst_spec, flatIn_eq, mono_mul, map_mul, pres_dword, flatOut_nil]

/-- Every output of the substitution has one block per replaced rule letter. -/
theorem subst_support (zr : List (ι × List D)) (sb : List (List D × S)) (c : List D)
    (o : Out D S) (ho : R.subst K zr sb c o ≠ 0) : o.1.length = sb.length + zr.length := by
  classical
  induction zr generalizing sb c with
  | nil =>
    simp only [subst, Finsupp.single_apply] at ho
    split_ifs at ho with h
    · subst h; simp
    · exact absurd rfl ho
  | cons p rest ih =>
    obtain ⟨i, v⟩ := p
    simp only [subst, Finsupp.sub_apply] at ho
    by_cases h₁ : R.subst K rest (sb ++ [((R.src (c, i, v)).1, (R.src (c, i, v)).2.1)])
        (R.src (c, i, v)).2.2 o = 0
    · rw [h₁, zero_sub, neg_ne_zero] at ho
      rw [ih _ _ ho]
      simp; omega
    · rw [ih _ _ h₁]
      simp; omega

/-- One substitution step, on stages that still contain a rule letter. -/
noncomputable def stepState : State D S ι → (State D S ι →₀ K)
  | (_, _, []) => 0
  | (sb, c, (i, v) :: rest) =>
      Finsupp.single (sb ++ [((R.src (c, i, v)).1, (R.src (c, i, v)).2.1)],
        (R.src (c, i, v)).2.2, rest) 1 -
      Finsupp.single (sb ++ [((R.tgt (c, i, v)).1, (R.tgt (c, i, v)).2.1)],
        (R.tgt (c, i, v)).2.2, rest) 1

variable (K) in
/-- `stepState`, extended linearly. -/
noncomputable def stepLin : (State D S ι →₀ K) →ₗ[K] (State D S ι →₀ K) :=
  Finsupp.linearCombination K R.stepState

/-- The stage obtained by inserting the rule letter `zᵢ` between the context words. -/
def insertEdge (sb : List (List D × S)) (rest : List (ι × List D)) (e : Edge D ι) : State D S ι :=
  (sb, e.1, (e.2.1, e.2.2) :: rest)

/-- The stage obtained by closing a block at a vertex. -/
def closeVertex (sb : List (List D × S)) (rest : List (ι × List D)) (x : Vertex D S) :
    State D S ι :=
  (sb ++ [(x.1, x.2.1)], x.2.2, rest)

theorem insertEdge_injective (sb : List (List D × S)) (rest : List (ι × List D)) :
    Function.Injective (insertEdge sb rest) := by
  rintro ⟨u, i, v⟩ ⟨u', i', v'⟩ h
  simp only [insertEdge, Prod.mk.injEq, List.cons.injEq] at h
  obtain ⟨-, rfl, ⟨rfl, rfl⟩, -⟩ := h
  rfl

theorem closeVertex_injective (sb : List (List D × S)) (rest : List (ι × List D)) :
    Function.Injective (closeVertex sb rest) := by
  rintro ⟨u, s, v⟩ ⟨u', s', v'⟩ h
  simp only [closeVertex, Prod.mk.injEq, List.append_cancel_left_eq, List.cons.injEq,
    and_true] at h
  obtain ⟨⟨rfl, rfl⟩, rfl, -⟩ := h
  rfl

theorem closeVertex_eq_iff {sb sb' : List (List D × S)} {rest rest' : List (ι × List D)}
    {x y : Vertex D S} (h : closeVertex sb' rest' x = closeVertex sb rest y) :
    sb' = sb ∧ rest' = rest := by
  simp only [closeVertex, Prod.mk.injEq] at h
  obtain ⟨h₁, -, h₃⟩ := h
  exact ⟨(List.append_inj' h₁ rfl).1, h₃⟩

/-- In each context the substitution step is the incidence map. -/
theorem stepLin_context (sb : List (List D × S)) (rest : List (ι × List D)) :
    (R.incidence K).comp (Finsupp.lcomapDomain (insertEdge sb rest) (insertEdge_injective sb rest)) =
      (Finsupp.lcomapDomain (closeVertex sb rest) (closeVertex_injective sb rest)).comp
        (R.stepLin K) := by
  classical
  apply Finsupp.lhom_ext
  rintro ⟨sb', c', zr'⟩ m
  simp only [LinearMap.comp_apply, Finsupp.lcomapDomain_apply, stepLin,
    Finsupp.linearCombination_single]
  cases zr' with
  | nil =>
    rw [Finsupp.comapDomain_single_of_notMem_range]
    · simp [stepState]
    · rintro ⟨e, he⟩
      simp [insertEdge] at he
  | cons p rest' =>
    obtain ⟨i, v⟩ := p
    simp only [stepState]
    by_cases hctx : sb' = sb ∧ rest' = rest
    · obtain ⟨rfl, rfl⟩ := hctx
      conv_lhs => rw [show ((sb', c', (i, v) :: rest') : State D S ι) =
        insertEdge sb' rest' (c', i, v) from rfl]
      rw [Finsupp.comapDomain_single, incidence_single, smul_sub]
      rw [← Finsupp.lcomapDomain_apply (R := K) _ (closeVertex_injective sb' rest'), smul_sub, map_sub,
        map_smul, map_smul, Finsupp.lcomapDomain_apply, Finsupp.lcomapDomain_apply]
      rw [show ((sb' ++ [((R.src (c', i, v)).1, (R.src (c', i, v)).2.1)], (R.src (c', i, v)).2.2,
          rest') : State D S ι) = closeVertex sb' rest' (R.src (c', i, v)) from rfl,
        show ((sb' ++ [((R.tgt (c', i, v)).1, (R.tgt (c', i, v)).2.1)], (R.tgt (c', i, v)).2.2,
          rest') : State D S ι) = closeVertex sb' rest' (R.tgt (c', i, v)) from rfl,
        Finsupp.comapDomain_single, Finsupp.comapDomain_single]
    · rw [Finsupp.comapDomain_single_of_notMem_range]
      · simp only [map_zero, smul_sub]
        rw [← Finsupp.lcomapDomain_apply (R := K) _ (closeVertex_injective sb rest), map_sub,
          map_smul, map_smul, Finsupp.lcomapDomain_apply, Finsupp.lcomapDomain_apply,
          Finsupp.comapDomain_single_of_notMem_range, Finsupp.comapDomain_single_of_notMem_range,
          smul_zero, sub_zero]
        · rintro ⟨y, hy⟩
          exact hctx (closeVertex_eq_iff (x := R.tgt (c', i, v)) hy.symm)
        · rintro ⟨y, hy⟩
          exact hctx (closeVertex_eq_iff (x := R.src (c', i, v)) hy.symm)
      · rintro ⟨e, he⟩
        simp only [insertEdge, Prod.mk.injEq, List.cons.injEq] at he
        exact hctx ⟨he.1.symm, he.2.2.2.symm⟩

/-- With no rule letter left, the substitution only reads off the blocks. -/
theorem substLin_injOn_zero (F : State D S ι →₀ K) (hF : ∀ st ∈ F.support, st.2.2 = [])
    (h0 : R.substLin K F = 0) : F = 0 := by
  classical
  ext ⟨sb, c, zr⟩
  by_contra hne
  have hzr : zr = [] := hF _ (Finsupp.mem_support_iff.mpr hne)
  subst hzr
  have := congrArg (fun f => f (sb, c)) h0
  simp only [substLin, Finsupp.linearCombination_apply, Finsupp.sum, Finsupp.finsetSum_apply,
    Finsupp.smul_apply, smul_eq_mul, Finsupp.coe_zero, Pi.zero_apply] at this
  rw [Finset.sum_eq_single (sb, c, [])] at this
  · simp [subst] at this
    exact hne this
  · rintro ⟨sb', c', zr'⟩ hst hne'
    have hzr' : zr' = [] := hF _ hst
    subst hzr'
    simp only [subst]
    rw [Finsupp.single_eq_of_ne', mul_zero]
    intro h
    apply hne'
    simp only [Prod.mk.injEq] at h
    rw [h.1, h.2]
  · intro hnot
    exact absurd (Finsupp.mem_support_iff.mpr hne) hnot

/-- One step of substitution does not change the final result. -/
theorem substLin_stepLin (F : State D S ι →₀ K) (hF : ∀ st ∈ F.support, st.2.2 ≠ []) :
    R.substLin K (R.stepLin K F) = R.substLin K F := by
  rw [stepLin, Finsupp.linearCombination_apply, map_finsuppSum, substLin,
    Finsupp.linearCombination_apply]
  refine Finsupp.sum_congr fun st hst => ?_
  obtain ⟨sb, c, zr⟩ := st
  cases zr with
  | nil => exact absurd rfl (hF _ hst)
  | cons p rest =>
    obtain ⟨i, v⟩ := p
    rw [map_smul]
    congr 1
    simp [stepState, subst]

/-- One step of substitution removes one rule letter. -/
theorem stepLin_support (F : State D S ι →₀ K) {n : ℕ}
    (hF : ∀ st ∈ F.support, st.2.2.length = n + 1) :
    ∀ st ∈ (R.stepLin K F).support, st.2.2.length = n := by
  classical
  intro st hst
  rw [stepLin, Finsupp.linearCombination_apply] at hst
  obtain ⟨st', hst', hst⟩ := Finset.mem_biUnion.mp (Finsupp.support_sum hst)
  have hst := Finsupp.support_smul hst
  obtain ⟨sb, c, zr⟩ := st'
  have hlen := hF _ hst'
  cases zr with
  | nil => simp [stepState] at hst
  | cons p rest =>
    obtain ⟨i, v⟩ := p
    simp only [stepState] at hst
    have hst := Finsupp.support_sub hst
    simp only [Finset.mem_union] at hst
    rcases hst with h | h <;>
    · rw [Finsupp.mem_support_single] at h
      obtain ⟨rfl, -⟩ := h
      simpa using hlen

/-- The kernel of one substitution step, read in the context `(sb, rest)`, is a kernel element of
the incidence map. -/
theorem incidence_comapDomain_eq_zero (F : State D S ι →₀ K) (hF : R.stepLin K F = 0)
    (sb : List (List D × S)) (rest : List (ι × List D)) :
    R.incidence K (Finsupp.comapDomain (insertEdge sb rest) F
      (insertEdge_injective sb rest).injOn) = 0 := by
  have hctx := congrArg (fun f => f F) (R.stepLin_context (K := K) sb rest)
  simpa only [LinearMap.comp_apply, hF, map_zero, Finsupp.lcomapDomain_apply] using hctx

/-- The substitution is injective on the stages with `n` remaining rule letters. -/
theorem substLin_injOn (hinc : Function.Injective (R.incidence K)) (n : ℕ) :
    ∀ F : State D S ι →₀ K, (∀ st ∈ F.support, st.2.2.length = n) →
      R.substLin K F = 0 → F = 0 := by
  classical
  induction n with
  | zero =>
    intro F hF h0
    exact R.substLin_injOn_zero F (fun st hst => List.length_eq_zero_iff.mp (hF st hst)) h0
  | succ n ih =>
    intro F hF h0
    have hne : ∀ st ∈ F.support, st.2.2 ≠ [] := fun st hst h => by
      have := hF st hst
      rw [h] at this
      simp at this
    have hF' : R.stepLin K F = 0 :=
      ih _ (R.stepLin_support F hF) (by rw [R.substLin_stepLin F hne, h0])
    ext ⟨sb, c, zr⟩
    cases zr with
    | nil =>
      by_contra hne'
      exact hne _ (Finsupp.mem_support_iff.mpr hne') rfl
    | cons p rest =>
      obtain ⟨i, v⟩ := p
      have := hinc ((R.incidence_comapDomain_eq_zero F hF' sb rest).trans (map_zero _).symm)
      have := congrArg (fun f => f (c, i, v)) this
      simpa [insertEdge] using this

/-- The stage of a word over the presentation alphabet. -/
def initState (w : List D × List (ι × List D)) : State D S ι := ([], w.1, w.2)

theorem initState_injective : Function.Injective (initState : _ → State D S ι) := by
  rintro ⟨u, zr⟩ ⟨u', zr'⟩ h
  simp only [initState, Prod.mk.injEq, true_and] at h
  rw [h.1, h.2]

variable (K) in
/-- The coefficients of a polynomial, indexed by initial stages. -/
noncomputable def blocks (p : Poly K (D ⊕ ι)) : State D S ι →₀ K :=
  Finsupp.mapDomain initState
    (Finsupp.comapDomain flatIn p.coeff flatIn_bijective.injective.injOn)

theorem blocks_apply (p : Poly K (D ⊕ ι)) (u : List D) (zr : List (ι × List D)) :
    blocks (S := S) K p ([], u, zr) = p.coeff (flatIn (u, zr)) := by
  rw [blocks, show (([], u, zr) : State D S ι) = initState (u, zr) from rfl,
    Finsupp.mapDomain_apply_of_injective (initState_injective (D := D) (S := S) (ι := ι)),
    Finsupp.comapDomain_apply]

theorem blocks_support (p : Poly K (D ⊕ ι)) : ∀ st ∈ (blocks (S := S) K p).support, st.1 = [] := by
  classical
  intro st hst
  obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hst)
  rfl

theorem pres_eq_substLin (p : Poly K (D ⊕ ι)) :
    R.pres K p = toPoly K D S (R.substLin K (blocks K p)) := by
  classical
  set g : (List D × List (ι × List D)) →₀ K :=
    Finsupp.comapDomain flatIn p.coeff flatIn_bijective.injective.injOn with hg
  have hp_eq : p = ∑ w ∈ g.support, g w • mono (flatIn w) := by
    conv_lhs => rw [sum_single p]
    refine (Finset.sum_bij (fun w _ => splitIn w.toList) ?_ ?_ ?_ ?_)
    · intro w hw
      simp only [hg, Finsupp.mem_support_iff, Finsupp.comapDomain_apply]
      rw [show flatIn (splitIn w.toList) = w from FreeMonoid.ext (flatIn_splitIn _)]
      exact Finsupp.mem_support_iff.mp hw
    · intro w₁ _ w₂ _ h
      rw [← FreeMonoid.ext (flatIn_splitIn w₁.toList), ← FreeMonoid.ext (flatIn_splitIn w₂.toList),
        h]
    · intro w hw
      refine ⟨flatIn w, ?_, splitIn_flatIn w⟩
      simpa [hg] using hw
    · intro w _
      simp only [hg, Finsupp.comapDomain_apply]
      rw [show flatIn (splitIn w.toList) = w from FreeMonoid.ext (flatIn_splitIn _)]
  conv_lhs => rw [hp_eq]
  rw [map_sum, substLin, blocks, ← hg, Finsupp.linearCombination_mapDomain,
    Finsupp.linearCombination_apply, map_finsuppSum, Finsupp.sum]
  refine Finset.sum_congr rfl fun w _ => ?_
  obtain ⟨u, zr⟩ := w
  rw [map_smul, pres_flatIn, map_smul]
  rfl

/-- A relation splits into relations with a fixed number of rule letters. -/
theorem substLin_filter_eq_zero (F : State D S ι →₀ K) (hF : ∀ st ∈ F.support, st.1 = [])
    (hT : R.substLin K F = 0) (n : ℕ) :
    R.substLin K (Finsupp.filter (fun st : State D S ι => st.2.2.length = n) F) = 0 := by
  classical
  ext o
  have key : ∀ (G : State D S ι →₀ K), (∀ st ∈ G.support, st.1 = [] ∧
      st.2.2.length ≠ o.1.length) → R.substLin K G o = 0 := by
    intro G hG
    simp only [substLin, Finsupp.linearCombination_apply, Finsupp.sum,
      Finsupp.finsetSum_apply, Finsupp.smul_apply, smul_eq_mul]
    refine Finset.sum_eq_zero fun st hst => ?_
    obtain ⟨h1, h2⟩ := hG st hst
    by_contra hne
    have := R.subst_support (K := K) st.2.2 st.1 st.2.1 o (right_ne_zero_of_mul hne)
    rw [h1] at this
    simp at this
    exact h2 this.symm
  by_cases hn : o.1.length = n
  · have hsplit := Finsupp.filter_add_filter_not F (fun st : State D S ι => st.2.2.length = n)
    have h₁ : R.substLin K (Finsupp.filter (fun st => ¬st.2.2.length = n) F) o = 0 := by
      apply key
      intro st hst
      rw [Finsupp.support_filter, Finset.mem_filter] at hst
      exact ⟨hF st hst.1, by rw [hn]; exact hst.2⟩
    have := congrArg (fun f => R.substLin K f o) hsplit
    simp only [map_add, Finsupp.add_apply, h₁, add_zero, hT, Finsupp.coe_zero,
      Pi.zero_apply] at this
    simpa using this
  · simp only [Finsupp.coe_zero, Pi.zero_apply]
    apply key
    intro st hst
    rw [Finsupp.support_filter, Finset.mem_filter] at hst
    exact ⟨hF st hst.1, by rw [hst.2]; exact Ne.symm hn⟩

/-- **Forest direction.** If the incidence map is injective, the presentation is injective. -/
theorem pres_injective (hinc : Function.Injective (R.incidence K)) :
    Function.Injective (R.pres K) := by
  classical
  rw [injective_iff_map_eq_zero]
  intro p hp
  have hT : R.substLin K (blocks K p) = 0 :=
    toPoly_injective (by rw [← pres_eq_substLin, hp, map_zero])
  have hgrade : ∀ n,
      Finsupp.filter (fun st : State D S ι => st.2.2.length = n) (blocks K p) = 0 := by
    intro n
    apply R.substLin_injOn hinc n
    · intro st hst
      rw [Finsupp.support_filter, Finset.mem_filter] at hst
      exact hst.2
    · exact R.substLin_filter_eq_zero _ (blocks_support p) hT n
  ext w
  have := congrArg (fun f => f ([], (splitIn w.toList).1, (splitIn w.toList).2))
    (hgrade (splitIn w.toList).2.length)
  simp only [Finsupp.filter_apply, Finsupp.coe_zero, Pi.zero_apply, ite_true] at this
  rw [blocks_apply, show flatIn ((splitIn w.toList).1, (splitIn w.toList).2) = w from
    FreeMonoid.ext (flatIn_splitIn _)] at this
  simpa using this

/-- **Bare rule letters.** If no kernel element of the incidence map involves an edge `(1, i, 1)`,
then every relation of the presentation lies in `I²`. -/
theorem highOrder_of_pres_eq_zero
    (hbare : ∀ g : Edge D ι →₀ K, R.incidence K g = 0 → ∀ i, g ([], i, []) = 0)
    (p : Poly K (D ⊕ ι)) (hp : R.pres K p = 0) : HighOrder 2 p := by
  classical
  have hT : R.substLin K (blocks K p) = 0 :=
    toPoly_injective (by rw [← pres_eq_substLin, hp, map_zero])
  -- Degree zero in the rule letters.
  have h0 : Finsupp.filter (fun st : State D S ι => st.2.2.length = 0) (blocks K p) = 0 := by
    apply R.substLin_injOn_zero
    · intro st hst
      rw [Finsupp.support_filter, Finset.mem_filter] at hst
      exact List.length_eq_zero_iff.mp hst.2
    · exact R.substLin_filter_eq_zero _ (blocks_support p) hT 0
  have hdeg0 : ∀ u : List D, p.coeff (flatIn (u, [])) = 0 := by
    intro u
    have := congrArg (fun f => f ([], u, [])) h0
    simpa [Finsupp.filter_apply, blocks_apply] using this
  -- Degree one in the rule letters.
  set F₁ := Finsupp.filter (fun st : State D S ι => st.2.2.length = 1) (blocks K p) with hF₁
  have hF₁supp : ∀ st ∈ F₁.support, st.2.2.length = 0 + 1 := by
    intro st hst
    rw [hF₁, Finsupp.support_filter, Finset.mem_filter] at hst
    exact hst.2
  have hstep : R.stepLin K F₁ = 0 := by
    apply R.substLin_injOn_zero
    · intro st hst
      exact List.length_eq_zero_iff.mp (R.stepLin_support F₁ hF₁supp st hst)
    · rw [R.substLin_stepLin F₁ (fun st hst h => by have := hF₁supp st hst; rw [h] at this; simp at this)]
      exact R.substLin_filter_eq_zero _ (blocks_support p) hT 1
  have hdeg1 : ∀ i, p.coeff (flatIn ([], [(i, [])])) = 0 := by
    intro i
    have := hbare _ (R.incidence_comapDomain_eq_zero F₁ hstep [] []) i
    simpa [hF₁, insertEdge, Finsupp.filter_apply, blocks_apply] using this
  intro w hw
  rcases Nat.lt_succ_iff_lt_or_eq.mp hw with h | h
  · have hw' : w = flatIn ([], []) :=
      FreeMonoid.ext (by simpa [flatIn] using List.length_eq_zero_iff.mp (Nat.lt_one_iff.mp h))
    rw [hw', hdeg0]
  · obtain ⟨x, hx⟩ := List.length_eq_one_iff.mp h
    rcases x with d | i
    · have hw' : w = flatIn ([d], []) := FreeMonoid.ext (by simpa [flatIn] using hx)
      rw [hw', hdeg0]
    · have hw' : w = flatIn ([], [(i, [])]) := FreeMonoid.ext (by simpa [flatIn] using hx)
      rw [hw', hdeg1]

end Rules

end SubalgebraFreeness
