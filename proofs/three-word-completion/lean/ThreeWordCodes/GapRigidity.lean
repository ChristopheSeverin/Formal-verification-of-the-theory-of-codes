module

public import ThreeWordCodes.Gaps
public import Mathlib.Data.ZMod.Basic

/-! # The coprime-residue argument in Lemma 2

Indices are the numbers of b's already seen. Multiples of m are token
boundaries in the forward comparison. The reverse comparison shifts them by n.
-/

@[expose] public section
namespace ThreeWordCodes.BinaryGaps
variable {m : ℕ} [NeZero m] {T : Type*}

omit [NeZero m] in
private theorem nonzero_multiple (s : (ZMod m)ˣ) (i : ℕ) (hi : 0 < i) (small : i < m) :
    (i : ZMod m) * (s : ZMod m) ≠ 0 := by
  intro he
  have h := congrArg (· * (↑s⁻¹ : ZMod m)) he
  simp [mul_assoc] at h
  have hv := congrArg ZMod.val h
  simp [ZMod.val_natCast_of_lt small] at hv
  omega

/-- Removing zero from a cyclic orbit generated by a unit leaves a connected path. -/
theorem constant_off_zero (s : (ZMod m)ˣ) (f : ZMod m → T)
    (edges : ∀ x : ZMod m, x ≠ 0 → x + s ≠ 0 → f x = f (x+s)) :
    ∀ x : ZMod m, x ≠ 0 → f x = f s := by
  have along (j : ℕ) (small : j+1 < m) : f ((j+1 : ℕ) * (s : ZMod m)) = f s := by
    induction j with
    | zero => simp
    | succ j ih =>
      have t := edges ((j+1 : ℕ) * (s : ZMod m))
        (nonzero_multiple s _ (by omega) (by omega))
      have eqn : ((j+1 : ℕ) : ZMod m) * s + s = ((j+2 : ℕ) : ZMod m) * s := by
        push_cast
        ring
      rw [eqn] at t
      exact (t (nonzero_multiple s _ (by omega) small)).symm.trans (ih (by omega))
  intro x hx
  let y := x * (↑s⁻¹ : ZMod m)
  have back : (y.val : ZMod m) * s = x := by simp [y, mul_assoc]
  have positive : y.val ≠ 0 := by
    intro he
    apply hx
    rw [← back,he]; simp
  have small := y.val_lt
  obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero positive
  rw [← back, hj]
  exact along j (by omega)

/-- Forward and backward alignments of the two gap lists force all internal gaps
to agree. The letter-comparison part of Lemma 2 provides the hypotheses. -/
theorem gaps_of_alignments {n : ℕ} (hm : 2 ≤ m) (hlen : m < n) (cop : n.Coprime m)
    (G : ZMod m → T) (E : ℕ → T)
    (forward : ∀ i, 0 < i → i < n → (i : ZMod m) ≠ 0 → E i = G i)
    (backward : ∀ i, 0 < i → i < n → (i : ZMod m) - n ≠ 0 → E i = G ((i : ZMod m)-n)) :
    ∃ g : T, (∀ z : ZMod m, z ≠ 0 → G z = g) ∧ (∀ i, 0 < i → i < n → E i = g) := by
  let u := ZMod.unitOfCoprime n cop
  have rep : (u : ZMod m) = n := ZMod.coe_unitOfCoprime ..
  have un : (u : ZMod m) ≠ 0 := by
    have := nonzero_multiple u 1 (by decide) (by omega)
    simpa using this
  have path := constant_off_zero u G (by
    intro x nx nc
    let z := x + u
    have nz : 0 < z.val := by
      by_contra! hz
      apply nc
      change z = 0
      rw [← ZMod.natCast_zmod_val z, show z.val = 0 by omega, Nat.cast_zero]
    have small : z.val < n := z.val_lt.trans hlen
    have hide : (z.val : ZMod m) - n = x := by simp [z, rep]
    have e₁ := forward z.val nz small (by simpa using nc)
    have e₂ := backward z.val nz small (hide ▸ nx)
    rw [hide] at e₂
    simpa [z] using e₂.symm.trans e₁)
  refine ⟨G u,path,?_⟩
  intro i pos small
  by_cases nz : (i : ZMod m) = 0
  · have nz' : (i : ZMod m) - n ≠ 0 := by
      rw [nz, zero_sub, neg_ne_zero, ← rep]
      exact un
    exact (backward i pos small nz').trans (path _ nz')
  · exact (forward i pos small nz).trans (path _ nz)

end ThreeWordCodes.BinaryGaps
